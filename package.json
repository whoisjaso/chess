{
  "name": "mindboard",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source chess platform that reads the mind behind the moves.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mindboard/web",
    "server": "npm run start -w @mindboard/server",
    "build": "npm run build -w @mindboard/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/web",
    "openings": "node scripts/build-openings.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
